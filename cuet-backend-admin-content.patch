@@ -0,0 +1,102 @@
+import { Programme, Cutoff } from "../models/index.js";
+import { logAudit } from "../utils/audit.js";
+import { handleDbError } from "../utils/handleDbError.js";
+
+const notFound = (res) => res.status(404).json({ success: false, message: "Cutoff not found." });
+
+const DUPLICATE_MSG =
+  "A cutoff for this programme, year, round and category already exists. Edit it instead.";
+
+// GET /api/admin/programmes/:id/cutoffs  (includes cutoffs not yet verified)
+export async function listCutoffsAdmin(req, res, next) {
+  try {
+    if (!(await Programme.exists({ _id: req.params.id }))) {
+      return res.status(404).json({ success: false, message: "Programme not found." });
+    }
+
+    const cutoffs = await Cutoff.find({ programme: req.params.id }).sort({
+      year: -1,
+      round: 1,
+      category: 1,
+    });
+
+    return res.status(200).json({ success: true, data: { cutoffs } });
+  } catch (error) {
+    next(error);
+  }
+}
+
+// POST /api/admin/programmes/:id/cutoffs
+export async function createCutoff(req, res, next) {
+  try {
+    if (!(await Programme.exists({ _id: req.params.id, isArchived: false }))) {
+      return res.status(404).json({ success: false, message: "Programme not found." });
+    }
+
+    const cutoff = await Cutoff.create({
+      ...req.body,
+      programme: req.params.id,
+      createdBy: req.user._id,
+    });
+
+    await logAudit({
+      userId: req.user._id,
+      action: "CREATE",
+      entity: "Cutoff",
+      entityId: cutoff._id,
+      after: cutoff.toObject(),
+    });
+
+    return res.status(201).json({ success: true, message: "Cutoff created.", data: { cutoff } });
+  } catch (error) {
+    if (!handleDbError(error, res, DUPLICATE_MSG)) next(error);
+  }
+}
+
+// PATCH /api/admin/cutoffs/:id
+export async function updateCutoff(req, res, next) {
+  try {
+    const cutoff = await Cutoff.findById(req.params.id);
+    if (!cutoff) return notFound(res);
+
+    const before = cutoff.toObject();
+    cutoff.set(req.body);
+    await cutoff.save();
+
+    await logAudit({
+      userId: req.user._id,
+      action: "UPDATE",
+      entity: "Cutoff",
+      entityId: cutoff._id,
+      before,
+      after: cutoff.toObject(),
+    });
+
+    return res.status(200).json({ success: true, message: "Cutoff updated.", data: { cutoff } });
+  } catch (error) {
+    if (!handleDbError(error, res, DUPLICATE_MSG)) next(error);
+  }
+}
+
+// DELETE /api/admin/cutoffs/:id
+export async function deleteCutoff(req, res, next) {
+  try {
+    const cutoff = await Cutoff.findById(req.params.id);
+    if (!cutoff) return notFound(res);
+
+    const before = cutoff.toObject();
+    await cutoff.deleteOne();
+
+    await logAudit({
+      userId: req.user._id,
+      action: "DELETE",
+      entity: "Cutoff",
+      entityId: cutoff._id,
+      before,
+    });
+
+    return res.status(200).json({ success: true, message: "Cutoff deleted." });
+  } catch (error) {
+    next(error);
+  }
+}
diff --git a/controllers/adminEventController.js b/controllers/adminEventController.js
new file mode 100644
index 0000000..1a0d4b4
--- /dev/null
+++ b/controllers/adminEventController.js
@@ -0,0 +1,155 @@
+import { University, Course, Programme, Event } from "../models/index.js";
+import { EVENT_TYPES } from "../models/constants.js";
+import { logAudit } from "../utils/audit.js";
+import { getPagination, paginationMeta } from "../utils/pagination.js";
+
+const notFound = (res) => res.status(404).json({ success: false, message: "Event not found." });
+const badRequest = (res, message) => res.status(400).json({ success: false, message });
+
+// A course-specific date must be for a course this university really offers
+async function courseProblem(universityId, courseId) {
+  if (!(await Course.exists({ _id: courseId, isActive: true }))) return "Course not found.";
+  const offered = await Programme.exists({ university: universityId, course: courseId, isArchived: false });
+  return offered ? null : "This university does not offer that course.";
+}
+
+// GET /api/admin/universities/:id/events  (includes events not yet verified)
+export async function listUniversityEventsAdmin(req, res, next) {
+  try {
+    if (!(await University.exists({ _id: req.params.id }))) {
+      return res.status(404).json({ success: false, message: "University not found." });
+    }
+
+    const { page, limit, skip } = getPagination(req.query);
+    const { type, verified } = req.query;
+
+    const filter = { university: req.params.id };
+    if (typeof type === "string" && EVENT_TYPES.includes(type)) filter.type = type;
+    if (verified === "true" || verified === "false") filter.verified = verified === "true";
+
+    const [events, total] = await Promise.all([
+      Event.find(filter).populate("course", "name slug").sort({ startsAt: 1, _id: 1 }).skip(skip).limit(limit),
+      Event.countDocuments(filter),
+    ]);
+
+    return res.status(200).json({
+      success: true,
+      data: { events, pagination: paginationMeta(page, limit, total) },
+    });
+  } catch (error) {
+    next(error);
+  }
+}
+
+// POST /api/admin/universities/:id/events
+export async function createEvent(req, res, next) {
+  try {
+    const university = await University.exists({ _id: req.params.id, isArchived: false });
+    if (!university) {
+      return res.status(404).json({ success: false, message: "University not found." });
+    }
+
+    const { courseId, ...fields } = req.body;
+
+    if (courseId) {
+      const problem = await courseProblem(req.params.id, courseId);
+      if (problem) return badRequest(res, problem);
+    }
+
+    // Stops the same date being entered twice
+    const duplicate = await Event.exists({
+      university: req.params.id,
+      course: courseId ?? null, // null also matches "no course"
+      type: fields.type,
+      title: fields.title,
+      startsAt: fields.startsAt,
+    });
+    if (duplicate) {
+      return res.status(409).json({ success: false, message: "This event already exists." });
+    }
+
+    const event = await Event.create({
+      ...fields,
+      university: req.params.id,
+      course: courseId,
+      createdBy: req.user._id,
+    });
+
+    await logAudit({
+      userId: req.user._id,
+      action: "CREATE",
+      entity: "Event",
+      entityId: event._id,
+      after: event.toObject(),
+    });
+
+    return res.status(201).json({ success: true, message: "Event created.", data: { event } });
+  } catch (error) {
+    if (error.name === "ValidationError") return badRequest(res, "Invalid data provided.");
+    next(error);
+  }
+}
+
+// PATCH /api/admin/events/:id
+export async function updateEvent(req, res, next) {
+  try {
+    const event = await Event.findById(req.params.id);
+    if (!event) return notFound(res);
+
+    const { courseId, ...fields } = req.body;
+
+    if (courseId) {
+      const problem = await courseProblem(event.university, courseId);
+      if (problem) return badRequest(res, problem);
+    }
+
+    const before = event.toObject();
+
+    event.set(fields);
+    if (courseId === null) event.course = undefined;
+    else if (courseId) event.course = courseId;
+
+    if (event.endsAt && event.endsAt < event.startsAt) {
+      return badRequest(res, "endsAt cannot be before startsAt.");
+    }
+
+    await event.save();
+
+    await logAudit({
+      userId: req.user._id,
+      action: "UPDATE",
+      entity: "Event",
+      entityId: event._id,
+      before,
+      after: event.toObject(),
+    });
+
+    return res.status(200).json({ success: true, message: "Event updated.", data: { event } });
+  } catch (error) {
+    if (error.name === "ValidationError") return badRequest(res, "Invalid data provided.");
+    next(error);
+  }
+}
+
+// DELETE /api/admin/events/:id  (the audit log keeps a copy of what was deleted)
+export async function deleteEvent(req, res, next) {
+  try {
+    const event = await Event.findById(req.params.id);
+    if (!event) return notFound(res);
+
+    const before = event.toObject();
+    await event.deleteOne();
+
+    await logAudit({
+      userId: req.user._id,
+      action: "DELETE",
+      entity: "Event",
+      entityId: event._id,
+      before,
+    });
+
+    return res.status(200).json({ success: true, message: "Event deleted." });
+  } catch (error) {
+    next(error);
+  }
+}
diff --git a/controllers/adminProgrammeController.js b/controllers/adminProgrammeController.js
new file mode 100644
index 0000000..e74462f
--- /dev/null
+++ b/controllers/adminProgrammeController.js
@@ -0,0 +1,175 @@
+import { University, Course, Programme } from "../models/index.js";
+import { logAudit } from "../utils/audit.js";
+import { getPagination, paginationMeta } from "../utils/pagination.js";
+import { isObjectId } from "../utils/isObjectId.js";
+import { handleDbError } from "../utils/handleDbError.js";
+
+const notFound = (res) => res.status(404).json({ success: false, message: "Programme not found." });
+const badRequest = (res, message) => res.status(400).json({ success: false, message });
+
+const DUPLICATE_MSG =
+  "This university already has a programme for that course (it may be archived: restore it with isArchived false).";
+
+const populateBoth = (query) =>
+  query.populate("university", "name shortName slug").populate("course", "name slug");
+
+export async function listProgrammesAdmin(req, res, next) {
+  try {
+    const { page, limit, skip } = getPagination(req.query);
+    const { universityId, courseId, verified, archived } = req.query;
+
+    if (universityId !== undefined && !isObjectId(universityId)) return badRequest(res, "Invalid universityId.");
+    if (courseId !== undefined && !isObjectId(courseId)) return badRequest(res, "Invalid courseId.");
+
+    const filter = { isArchived: archived === "true" };
+    if (universityId) filter.university = universityId;
+    if (courseId) filter.course = courseId;
+    if (verified === "true" || verified === "false") filter.verified = verified === "true";
+
+    const [programmes, total] = await Promise.all([
+      populateBoth(Programme.find(filter).sort({ updatedAt: -1, _id: 1 }).skip(skip).limit(limit)),
+      Programme.countDocuments(filter),
+    ]);
+
+    return res.status(200).json({
+      success: true,
+      data: { programmes, pagination: paginationMeta(page, limit, total) },
+    });
+  } catch (error) {
+    next(error);
+  }
+}
+
+export async function getProgrammeAdmin(req, res, next) {
+  try {
+    const programme = await populateBoth(Programme.findById(req.params.id));
+    if (!programme) return notFound(res);
+    return res.status(200).json({ success: true, data: { programme } });
+  } catch (error) {
+    next(error);
+  }
+}
+
+export async function createProgramme(req, res, next) {
+  try {
+    const { universityId, courseId, ...fields } = req.body;
+
+    if (!(await University.exists({ _id: universityId, isArchived: false }))) {
+      return res.status(404).json({ success: false, message: "University not found." });
+    }
+    if (!(await Course.exists({ _id: courseId, isActive: true }))) {
+      return res.status(404).json({ success: false, message: "Course not found." });
+    }
+
+    const programme = await Programme.create({
+      ...fields,
+      university: universityId,
+      course: courseId,
+      updatedBy: req.user._id,
+    });
+
+    await logAudit({
+      userId: req.user._id,
+      action: "CREATE",
+      entity: "Programme",
+      entityId: programme._id,
+      after: programme.toObject(),
+    });
+
+    return res.status(201).json({ success: true, message: "Programme created.", data: { programme } });
+  } catch (error) {
+    if (!handleDbError(error, res, DUPLICATE_MSG)) next(error);
+  }
+}
+
+export async function updateProgramme(req, res, next) {
+  try {
+    const programme = await Programme.findById(req.params.id);
+    if (!programme) return notFound(res);
+
+    const before = programme.toObject();
+
+    programme.set(req.body);
+    programme.updatedBy = req.user._id;
+
+    // Checked after merging, so changing only one of the two numbers is also caught
+    if (
+      programme.seatsAvailable !== undefined &&
+      programme.totalSeats !== undefined &&
+      programme.seatsAvailable > programme.totalSeats
+    ) {
+      return badRequest(res, "seatsAvailable cannot be more than totalSeats.");
+    }
+
+    await programme.save();
+
+    await logAudit({
+      userId: req.user._id,
+      action: "UPDATE",
+      entity: "Programme",
+      entityId: programme._id,
+      before,
+      after: programme.toObject(),
+    });
+
+    return res.status(200).json({ success: true, message: "Programme updated.", data: { programme } });
+  } catch (error) {
+    if (!handleDbError(error, res, DUPLICATE_MSG)) next(error);
+  }
+}
+
+export async function archiveProgramme(req, res, next) {
+  try {
+    const programme = await Programme.findById(req.params.id);
+    if (!programme) return notFound(res);
+
+    const before = programme.toObject();
+    programme.isArchived = true;
+    programme.updatedBy = req.user._id;
+    await programme.save();
+
+    await logAudit({
+      userId: req.user._id,
+      action: "UPDATE",
+      entity: "Programme",
+      entityId: programme._id,
+      before,
+      after: programme.toObject(),
+    });
+
+    return res.status(200).json({ success: true, message: "Programme archived." });
+  } catch (error) {
+    next(error);
+  }
+}
+
+// "I just checked this against the official source"
+export async function verifyProgramme(req, res, next) {
+  try {
+    const programme = await Programme.findById(req.params.id);
+    if (!programme) return notFound(res);
+
+    const before = programme.toObject();
+    programme.verified = true;
+    programme.lastVerifiedAt = new Date();
+    programme.updatedBy = req.user._id;
+    await programme.save();
+
+    await logAudit({
+      userId: req.user._id,
+      action: "UPDATE",
+      entity: "Programme",
+      entityId: programme._id,
+      before,
+      after: programme.toObject(),
+    });
+
+    return res.status(200).json({
+      success: true,
+      message: "Programme marked as verified.",
+      data: { programme },
+    });
+  } catch (error) {
+    next(error);
+  }
+}
