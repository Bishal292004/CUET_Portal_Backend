PORT=5000
MONGODB_URI=your-atlas-connection-string
FRONTEND_ORIGIN=http://localhost:5173

# Auth: generate each secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=a-long-random-string
JWT_EXPIRES_IN=7d
EMAIL_OTP_SECRET=a-different-long-random-string

# Email (SMTP). For Gmail use smtp.gmail.com, port 587, and an App Password
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-smtp-username
MAIL_PASS=your-smtp-password
MAIL_FROM="CUET PG Portal <no-reply@example.com>"

# Set to production on the hosting platform
# NODE_ENV=production
